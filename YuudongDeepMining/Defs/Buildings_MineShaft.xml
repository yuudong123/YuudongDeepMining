<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <ThingDef ParentName="BuildingBase" Name="YDM_MineShaftBase" Abstract="True">
    <thingClass>YuudongDeepMining.Building_MineShaft</thingClass>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <tickerType>Normal</tickerType>
    <altitudeLayer>Building</altitudeLayer>
    <passability>Impassable</passability>
    <fillPercent>0.4</fillPercent>
    <holdsRoof>true</holdsRoof>
    <canOverlapZones>false</canOverlapZones>
    <terrainAffordanceNeeded>Heavy</terrainAffordanceNeeded>
    <designationCategory>Misc</designationCategory>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>YDM/MineShaft</texPath>
      <!-- 나무 틀이 2x2를 덮고, 둘레 흙·자갈이 조금 밖으로 나온다. -->
      <drawSize>(2.41,2.41)</drawSize>
    </graphicData>
    <uiIconPath>YDM/MineShaft</uiIconPath>
    <placeWorkers>
      <li>YuudongDeepMining.PlaceWorker_MineShaft</li>
    </placeWorkers>
    <building>
      <isEdifice>true</isEdifice>
      <deconstructible>false</deconstructible>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
      <!-- 적의 부수기·돌파 AI와 짜증 발작이 갱도를 목표로 고르지 않는다. 직접 공격 지정은 된다. -->
      <ai_neverTrashThis>true</ai_neverTrashThis>
    </building>
    <portal>
      <pocketMapGenerator>YDM_Underground</pocketMapGenerator>
      <exitDef>YDM_MineShaftExit</exitDef>
      <pocketMapSize>150</pocketMapSize>
    </portal>
    <inspectorTabs>
      <li>ITab_ContentsMapPortal</li>
    </inspectorTabs>
    <!-- 상호작용 금지: 금지하면 정착지 림이 이 갱도로 내려가지 않는다. 아래층 사다리(올라오기)는 그대로 쓸 수 있다.
         길찾기에는 영향이 없다 (문이 아닌 통과 불가 건물이라 금지 여부가 경로 격자에 쓰이지 않는다). -->
    <comps>
      <li Class="CompProperties_Forbiddable" />
    </comps>
  </ThingDef>

  <ThingDef ParentName="YDM_MineShaftBase">
    <defName>YDM_MineShaft</defName>
    <label>mine shaft</label>
    <description>A timbered shaft dug straight down into the bedrock. It opens onto a new underground level full of rock and ore veins, so the mountains around your base can stay untouched.\n\nOnly one shaft can be built per map. Sealing or destroying the shaft collapses every level below it: everything inside is lost and every creature down there is crushed.</description>
    <statBases>
      <MaxHitPoints>1500</MaxHitPoints>
      <WorkToBuild>8000</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-5</Beauty>
    </statBases>
    <costList>
      <Steel>100</Steel>
      <WoodLog>150</WoodLog>
    </costList>
    <constructionSkillPrerequisite>4</constructionSkillPrerequisite>
  </ThingDef>

  <!-- 폐쇄된 갱도: 갱도를 폐쇄하면 그 자리에 남는다. 짓지는 못하고, 해체해서 자리를 비울 수 있다. -->
  <ThingDef ParentName="BuildingBase">
    <defName>YDM_SealedShaft</defName>
    <label>sealed mine shaft</label>
    <description>A mine shaft that has been filled with earth and boarded over. Everything that was below it is gone for good.

Deconstruct it to clear the spot.</description>
    <size>(2,2)</size>
    <rotatable>false</rotatable>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <passability>Standable</passability>
    <pathCost>14</pathCost>
    <canOverlapZones>false</canOverlapZones>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>YDM/SealedShaft</texPath>
      <drawSize>(2.41,2.41)</drawSize>
    </graphicData>
    <uiIconPath>YDM/SealedShaft</uiIconPath>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1500</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>-3</Beauty>
    </statBases>
    <costList>
      <WoodLog>30</WoodLog>
    </costList>
    <building>
      <isEdifice>false</isEdifice>
      <claimable>false</claimable>
      <expandHomeArea>false</expandHomeArea>
      <ai_chillDestination>false</ai_chillDestination>
      <ai_neverTrashThis>true</ai_neverTrashThis>
    </building>
  </ThingDef>

  <ThingDef ParentName="PocketMapExit">
    <defName>YDM_MineShaftExit</defName>
    <label>shaft ladder</label>
    <description>A ladder leading back up the mine shaft.</description>
    <thingClass>YuudongDeepMining.Building_MineShaftExit</thingClass>
    <size>(2,2)</size>
    <altitudeLayer>FloorEmplacement</altitudeLayer>
    <graphicData>
      <graphicClass>Graphic_Single</graphicClass>
      <texPath>YDM/MineShaftExit</texPath>
      <!-- 사다리 윗부분이 천장 빛 속으로 부드럽게 사라지도록 반투명을 그대로 그린다 (기본 Cutout은 반투명을 잘라 깨져 보임). -->
      <shaderType>Transparent</shaderType>
      <!-- 나무 틀이 2x2를 덮고, 사다리는 위쪽으로 길게 나온다. -->
      <drawSize>(3.43,3.43)</drawSize>
    </graphicData>
    <uiIconPath>YDM/MineShaftExit</uiIconPath>
    <statBases>
      <Flammability>0</Flammability>
    </statBases>
    <comps>
      <li Class="CompProperties_Glower">
        <glowRadius>7</glowRadius>
        <glowColor>(217,200,160,0)</glowColor>
      </li>
    </comps>
  </ThingDef>

</Defs>
