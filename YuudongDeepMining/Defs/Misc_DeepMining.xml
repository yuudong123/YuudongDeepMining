<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- 갱도 붕괴로 죽을 때의 피해. 사망 메시지가 따로 나온다. -->
  <DamageDef>
    <defName>YDM_CaveIn</defName>
    <label>cave-in</label>
    <workerClass>DamageWorker_AddInjury</workerClass>
    <externalViolence>true</externalViolence>
    <deathMessage>{0} was buried alive when the mine shaft caved in.</deathMessage>
    <hediff>Crush</hediff>
    <hediffSkin>Cut</hediffSkin>
    <hediffSolid>Crack</hediffSolid>
    <harmAllLayersUntilOutside>true</harmAllLayersUntilOutside>
    <impactSoundType>Blunt</impactSoundType>
    <armorCategory>Blunt</armorCategory>
  </DamageDef>

  <!-- 영리한 습격대가 갱도로 내려갈 때의 임무. -->
  <DutyDef>
    <defName>YDM_EnterShaft</defName>
    <alwaysShowWeapon>true</alwaysShowWeapon>
    <thinkNode Class="ThinkNode_Priority">
      <subNodes>
        <li Class="JobGiver_EnterPortal" />
        <li Class="JobGiver_AIFightEnemies">
          <targetAcquireRadius>30</targetAcquireRadius>
          <targetKeepRadius>40</targetKeepRadius>
        </li>
        <li Class="JobGiver_AITrashColonyClose" />
        <li Class="JobGiver_WanderNearDutyLocation">
          <wanderRadius>6</wanderRadius>
        </li>
      </subNodes>
    </thinkNode>
  </DutyDef>

  <!-- 층 넘는 직접 운반: 물건을 들고 사다리를 지나 다른 층 창고에 넣는다. 사다리를 지나도 물건을 내려놓지 않는다. -->
  <JobDef>
    <defName>YDM_HaulAcrossLayers</defName>
    <driverClass>YuudongDeepMining.JobDriver_HaulAcrossLayers</driverClass>
    <reportString>carrying TargetA to another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
    <allowOpportunisticPrefix>true</allowOpportunisticPrefix>
  </JobDef>

  <JobDef>
    <defName>YDM_CarryThroughPortal</defName>
    <driverClass>YuudongDeepMining.JobDriver_CarryThroughPortal</driverClass>
    <reportString>carrying something through TargetA.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
    <dropThingBeforeJob>false</dropThingBeforeJob>
  </JobDef>

  <JobDef>
    <defName>YDM_PlaceCarried</defName>
    <driverClass>YuudongDeepMining.JobDriver_PlaceCarried</driverClass>
    <reportString>storing what they carried.</reportString>
    <dropThingBeforeJob>false</dropThingBeforeJob>
  </JobDef>

  <!-- 사람 옮기기: 쓰러진 림을 들고 사다리를 넘은 뒤, 도착한 층에서 바닐라 구조·포획 작업으로 넘긴다. -->
  <JobDef>
    <defName>YDM_RescueAcrossLayers</defName>
    <driverClass>YuudongDeepMining.JobDriver_HaulAcrossLayers</driverClass>
    <reportString>carrying TargetA to a bed on another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
  </JobDef>

  <JobDef>
    <defName>YDM_CaptureAcrossLayers</defName>
    <driverClass>YuudongDeepMining.JobDriver_HaulAcrossLayers</driverClass>
    <reportString>carrying TargetA to a prison on another level.</reportString>
    <carryThingAfterJob>true</carryThingAfterJob>
  </JobDef>

  <WorkGiverDef>
    <defName>YDM_RescueAcrossLayers</defName>
    <label>rescue downed allies to a bed on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_RescueAcrossLayers</giverClass>
    <workType>Doctor</workType>
    <verb>rescue</verb>
    <gerund>rescuing</gerund>
    <priorityInType>59</priorityInType>
    <directOrderable>false</directOrderable>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>YDM_SupplyBillsAcrossLayers</defName>
    <label>bring ingredients to a workbench on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyBillsAcrossLayers</giverClass>
    <workType>Hauling</workType>
    <verb>bring</verb>
    <gerund>bringing ingredients</gerund>
    <priorityInType>13</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- 다른 층 청사진·틀에 모자란 건설 재료 가져가기. 바닐라 청사진 재료 운반(DeliverResourcesToBlueprints, 9)과 같은 순서 자리. -->
  <WorkGiverDef>
    <defName>YDM_SupplyConstructionAcrossLayers</defName>
    <label>bring construction materials to another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyConstructionAcrossLayers</giverClass>
    <workType>Hauling</workType>
    <verb>bring</verb>
    <gerund>bringing construction materials</gerund>
    <priorityInType>9</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- 건설 담당도 다른 층 청사진 재료를 직접 가져간다 (바닐라 건설 재료 운반 ConstructDeliverResourcesToBlueprints와 같은 순서 자리 60). -->
  <WorkGiverDef>
    <defName>YDM_SupplyConstructionAcrossLayers_Construction</defName>
    <label>bring construction materials to another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyConstructionAcrossLayers</giverClass>
    <workType>Construction</workType>
    <verb>bring</verb>
    <gerund>bringing construction materials</gerund>
    <priorityInType>60</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- 제작 담당도 자기 작업대 일의 재료를 다른 층에서 가져간다 (그 작업 종류의 작업대 일들 바로 뒤 순서). -->
  <WorkGiverDef>
    <defName>YDM_SupplyBillsAcrossLayers_Cooking</defName>
    <label>bring ingredients to a workbench on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyBillsAcrossLayers</giverClass>
    <workType>Cooking</workType>
    <verb>bring</verb>
    <gerund>bringing ingredients</gerund>
    <priorityInType>25</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>YDM_SupplyBillsAcrossLayers_Crafting</defName>
    <label>bring ingredients to a workbench on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyBillsAcrossLayers</giverClass>
    <workType>Crafting</workType>
    <verb>bring</verb>
    <gerund>bringing ingredients</gerund>
    <priorityInType>75</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>YDM_SupplyBillsAcrossLayers_Smithing</defName>
    <label>bring ingredients to a workbench on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyBillsAcrossLayers</giverClass>
    <workType>Smithing</workType>
    <verb>bring</verb>
    <gerund>bringing ingredients</gerund>
    <priorityInType>45</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>YDM_SupplyBillsAcrossLayers_Tailoring</defName>
    <label>bring ingredients to a workbench on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyBillsAcrossLayers</giverClass>
    <workType>Tailoring</workType>
    <verb>bring</verb>
    <gerund>bringing ingredients</gerund>
    <priorityInType>105</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>YDM_SupplyBillsAcrossLayers_Art</defName>
    <label>bring ingredients to a workbench on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyBillsAcrossLayers</giverClass>
    <workType>Art</workType>
    <verb>bring</verb>
    <gerund>bringing ingredients</gerund>
    <priorityInType>95</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>YDM_SupplyBillsAcrossLayers_Doctor</defName>
    <label>bring ingredients to a workbench on another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_SupplyBillsAcrossLayers</giverClass>
    <workType>Doctor</workType>
    <verb>bring</verb>
    <gerund>bringing ingredients</gerund>
    <priorityInType>25</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <WorkGiverDef>
    <defName>YDM_HaulAcrossLayers</defName>
    <label>haul to another level</label>
    <giverClass>YuudongDeepMining.WorkGiver_HaulAcrossLayers</giverClass>
    <workType>Hauling</workType>
    <verb>haul</verb>
    <gerund>hauling</gerund>
    <!-- 바닐라 일반 운반(HaulGeneral)과 같은 순서 묶음. 묶음 안에서는 나중에 본 작업의 대상이 쓰이므로, 다른 층으로 옮길 물건이 있으면 그것을 먼저 한다. -->
    <priorityInType>15</priorityInType>
    <requiredCapacities>
      <li>Manipulation</li>
    </requiredCapacities>
  </WorkGiverDef>

  <!-- 일·욕구보다 먼저: 배고픔·졸림으로 올라가기, 진행 중인 층 이동 이어 가기. -->
  <ThinkTreeDef>
    <defName>YDM_LayerTravel</defName>
    <insertTag>Humanlike_PreMain</insertTag>
    <insertPriority>100</insertPriority>
    <thinkRoot Class="ThinkNode_ConditionalColonist">
      <subNodes>
        <li Class="YuudongDeepMining.JobGiver_LayerTravel" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- 이 층에 할 일이 없을 때: 다른 층 일거리로 가거나, 주로 머무는 층으로 돌아가기. -->
  <ThinkTreeDef>
    <defName>YDM_LayerIdle</defName>
    <insertTag>Humanlike_PostMain</insertTag>
    <insertPriority>100</insertPriority>
    <thinkRoot Class="ThinkNode_ConditionalColonist">
      <subNodes>
        <li Class="YuudongDeepMining.JobGiver_LayerIdle" />
      </subNodes>
    </thinkRoot>
  </ThinkTreeDef>

  <!-- 동물: 주인이 다른 층에 있고 바닐라 '따라가기' 조건을 만족하면 사다리를 타고 따라간다. -->
  <ThinkTreeDef>
    <defName>YDM_AnimalFollowAcrossLayers</defName>
    <insertTag>Animal_PreMain</insertTag>
    <insertPriority>100</insertPriority>
    <thinkRoot Class="YuudongDeepMining.JobGiver_AnimalFollowAcrossLayers" />
  </ThinkTreeDef>

  <KeyBindingDef>
    <defName>YDM_LayerUp</defName>
    <label>deep mining: view the level above</label>
    <category>Game</category>
    <defaultKeyCodeA>Equals</defaultKeyCodeA>
  </KeyBindingDef>

  <KeyBindingDef>
    <defName>YDM_LayerDown</defName>
    <label>deep mining: view the level below</label>
    <category>Game</category>
    <defaultKeyCodeA>Minus</defaultKeyCodeA>
  </KeyBindingDef>

</Defs>
